.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local data and user-generated outputs should not be committed.
local_data/
/data/*
!/data/external_validation_manifest/
/data/external_validation_manifest/*
!/data/external_validation_manifest/README.txt
!/data/external_validation_manifest/data_dictionary.json
!/data/external_validation_manifest/external_samples.tsv
!/data/external_validation_manifest/source_studies.tsv
work/
tmp/
outputs/
examples/example_predictions.tsv

# Raw or individual-level methylation artifacts are intentionally excluded.
*.idat
*.parquet
*.h5
*.hdf5
*.loom
*.npy
*.npz
*.rds
*.rda
*.pkl
*.pickle
